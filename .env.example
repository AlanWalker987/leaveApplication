# Core
NODE_ENV=development

# Application URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:5000
GRAPHQL_ENDPOINT=http://localhost:5000/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:5000/graphql

# Ports
WEB_PORT=3000
API_PORT=5000
POSTGRES_PORT=5433

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lms

# JWT placeholders
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
