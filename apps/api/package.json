{
  "name": "@lms/api",
  "private": true,
  "version": "0.0.1",
  "prisma": {
    "seed": "ts-node prisma/seed-dev.ts"
  },
  "scripts": {
    "dev": "rimraf dist tsconfig.build.tsbuildinfo && nest start --watch",
    "build": "rimraf dist tsconfig.build.tsbuildinfo && nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "generate:graphql-types": "ts-node src/generate-types.ts",
    "postgres-up": "docker-compose -f docker-compose.yml up -d postgres",
    "postgres-down": "docker-compose -f docker-compose.yml down",
    "prisma:generate": "prisma generate --allow-no-models",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio --port 5555",
    "seed": "prisma db seed",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.22.0",
    "apollo-server-express": "^3.13.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.11.1",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
