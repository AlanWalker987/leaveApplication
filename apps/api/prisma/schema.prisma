generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Manager
  Employee
}

enum Gender {
  Male
  Female
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

enum LeaveEligibilityGender {
  Any
  FemaleOnly
}

model Test {
  id   Int    @id @default(autoincrement())
  bio  String
  role String @unique
}

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  location  String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([isDeleted, name])
  @@index([isDeleted, createdAt])
}

model User {
  id                       String                @id @default(uuid())
  firstName                String
  lastName                 String
  email                    String                @unique
  hash                     String
  tokenVersion             Int                   @default(0)
  managerId                String?
  manager                  User?                 @relation("UserManager", fields: [managerId], references: [id])
  directReports            User[]                @relation("UserManager")
  departmentId             String?
  department               Department?           @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments       Department[]          @relation("DepartmentManager")
  branchId                 String?
  branch                   Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vendorId                 String?
  vendor                   Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  refreshSessions          RefreshTokenSession[]
  leaveTrackers            LeaveTracker[]
  appliedLeaveApplications LeaveApplication[]    @relation("LeaveApplicant")
  managedLeaveApplications LeaveApplication[]    @relation("LeaveManager")
  userRole                 Role
  phoneNumber              String
  designation              String
  dateOfBirth              DateTime
  dateOfJoining            DateTime
  emergencyContactName     String
  emergencyContactNumber   String
  gender                   Gender?
  createAt                 DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  isDeleted                Boolean               @default(false)

  @@index([isDeleted, firstName])
  @@index([isDeleted, lastName])
  @@index([isDeleted, createAt])
}

model RefreshTokenSession {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String                @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  replacedBy   RefreshTokenSession?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces     RefreshTokenSession[] @relation("RefreshTokenRotation")
  createdAt    DateTime              @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Vendor {
  id            String   @id @default(uuid())
  name          String
  contactName   String
  contactNumber String
  contactEmail  String
  users         User[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  @@index([isDeleted, name])
  @@index([isDeleted, createdAt])
}

model PublicHolidays {
  id          String   @id @default(uuid())
  holidayDate DateTime
  title       String
  createdAt   DateTime
  updatedAt   DateTime
  isDeleted   Boolean  @default(false)

  @@index([isDeleted, title])
  @@index([isDeleted, holidayDate])
}

model LeaveTypes {
  id                String             @id @default(uuid())
  code              String             @unique
  description       String
  annualAllowance   Int                @default(0)
  eligibilityGender LeaveEligibilityGender @default(Any)
  leaveApplications LeaveApplication[]
  createAt          DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)

  @@index([isDeleted, description])
  @@index([isDeleted, createAt])
}

model LeaveTracker {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year                Int
  openingLeaveCount   Decimal  @default(20.0)
  pendingLeaveCount   Decimal  @default(0.0)
  approvedLeaveCount  Decimal  @default(0.0)
  cancelledLeaveCount Decimal  @default(0.0)
  rejectedLeaveCount  Decimal  @default(0.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  @@unique([userId, year])
  @@index([userId])
  @@index([year])
}

model LeaveApplication {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  managerId   String?
  manager     User?       @relation("LeaveManager", fields: [managerId], references: [id], onDelete: SetNull)
  leaveTypeId String
  leaveType   LeaveTypes  @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reason      String
  fromDate    DateTime
  toDate      DateTime
  totalDays   Decimal     @db.Decimal(2, 1)
  status      LeaveStatus @default(Pending)
  comments    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isDeleted   Boolean     @default(false)

  @@index([userId, status])
  @@index([managerId, status])
  @@index([leaveTypeId])
  @@index([fromDate])
  @@index([toDate])
  @@index([isDeleted, status, createdAt])
  @@index([isDeleted, createdAt])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  subtitle  String
  location  String
  managerId String
  manager   User     @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: Restrict)
  employees User[]   @relation("DepartmentEmployees")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([managerId])
  @@index([name])
}
